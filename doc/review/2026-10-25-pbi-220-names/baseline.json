  "targets": [
    {
      "id": "bone-carpus",
      "layer": "skeleton",
      "nameJa": "手根骨",
      "nameLa": "Ossa carpi",
      "nameEn": "Carpus (knee)",
      "region": "前肢",
      "summary": "前肢の「膝」。2列の小骨で作る複関節。",
      "body": "橈骨の遠位端と中手骨の間を2列の小骨（橈側手根骨・中手根骨・尺側手根骨・副手根骨ほか）でつなぐ複関節です。人の手首に相当し、屈折して衝撃を吸収します。競走馬ではチップ骨折・関節炎の好発部位で、球節より上の腫れはまずここを疑います。",
      "function": "前肢の屈曲関節。",
      "views": [
        "left",
        "right"
      ]
    },
    {
      "id": "bone-sesamoid",
      "layer": "skeleton",
      "nameJa": "種子骨",
      "nameLa": "Ossa sesamoidea proximalia",
      "nameEn": "Proximal sesamoid bones",
      "region": "前肢",
      "summary": "球節の後ろにある2個の小骨。",
      "body": "球節（繋部の関節）の掌側にある2個の小さな骨で、第3中手骨と繋骨の間の関節を作ります。繋靱帯（サスペンソリ靱帯）の枝が止まる付着部であり、屈腱が通る滑車でもあります。競走馬の剥離骨折・種子骨炎の好発部位です。",
      "function": "球節の滑車と靱帯の支点。",
      "views": [
        "left",
        "right"
      ]
    },
    {
      "id": "bone-tarsus",
      "layer": "skeleton",
      "nameJa": "跗骨",
      "nameLa": "Ossa tarsi",
      "nameEn": "Tarsus (hock)",
      "region": "後肢",
      "summary": "飛節の小骨群。距骨・踵骨を含む。",
      "body": "脛骨と中趾骨の間を何段かの小骨でつなぐ飛節（ホック）の関節です。距骨・踵骨・中心足根骨ほかで構成され、後肢の推進力を地面へ伝えます。飛節内腫（ボーン・スパビン）は跛行の代表的な原因部位です。",
      "function": "後肢の屈曲関節。",
      "views": [
        "left",
        "right"
      ]
    },
    {
      "id": "bone-metatarsus",
      "layer": "skeleton",
      "nameJa": "中趾骨",
      "nameLa": "Ossa metatarsalia",
      "nameEn": "Metatarsus",
      "region": "後肢",
      "summary": "後肢の管骨。前肢の中手骨に相当。",
