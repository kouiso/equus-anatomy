APP_IDENTIFIER = "jp.co.ritmo.equusanatomy"
TEAM_ID = "ZZ4FA7NLUY"
MATCH_GIT_URL = "git@github.com:ritmo-inc/apple-certificate.git"
MATCH_GIT_BRANCH = "master"

default_platform(:ios)

platform :ios do
  desc "FAD テスターの UDID を取得して Apple Developer Portal に登録する"
  lane :register_devices_from_firebase do |options|
    app = options[:app] || ENV["FIREBASE_IOS_APP_ID"]
    devices_file = options[:output] || File.expand_path("../.device-sync/fad_devices.txt", __dir__)
    api_key_path = options[:api_key_path] || ENV["ASC_API_KEY_PATH"]

    UI.user_error!("app は必須です") if app.to_s.empty?
    UI.user_error!("api_key_path もしくは ASC_API_KEY_PATH が必要です") if api_key_path.to_s.empty?

    FileUtils.mkdir_p(File.dirname(devices_file))
    udid_options = {
      app: app,
      output_file: devices_file,
    }
    firebase_token = ENV["FIREBASE_AUTH_TOKEN"] || ENV["FIREBASE_TOKEN"]
    udid_options[:firebase_cli_token] = firebase_token unless firebase_token.to_s.empty?
    firebase_app_distribution_get_udids(**udid_options)

    device_count = File.exist?(devices_file) \
      ? File.readlines(devices_file).reject { |line| line.start_with?("Device ID") }.count { |line| !line.strip.empty? } \
      : 0
    UI.message("検出されたデバイス数: #{device_count}")
    next if device_count == 0

    register_devices(
      devices_file: devices_file,
      team_id: TEAM_ID,
      api_key_path: api_key_path,
    )
  end

  desc "ASC にアプリレコードを作成する（bundle id は登録済み前提。初回のみ・冪等）"
  lane :asc_app do
    setup_ci

    # WHY produce は Apple ID セッション(FASTLANE_USER +
    # FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD)で走る。ASC API キーでは
    # /v1/apps の CREATE が 403 のためアプリレコードを作れない。
    produce(
      username: ENV["FASTLANE_USER"],
      app_identifier: APP_IDENTIFIER,
      app_name: "EQUUS Horse Anatomy",
      sku: APP_IDENTIFIER,
      team_id: TEAM_ID,
      language: "Japanese",
      skip_itc: false,
      enable_services: {},
    )
  end

  desc "AdHoc 署名で IPA をビルドする（provision:true で match を書き込みモードにする）"
  lane :fad do |options|
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
    )

    provision = options[:provision] == true
    match(
      type: "adhoc",
      app_identifier: APP_IDENTIFIER,
      git_url: MATCH_GIT_URL,
      git_branch: MATCH_GIT_BRANCH,
      team_id: TEAM_ID,
      readonly: !provision,
      force_for_new_devices: provision,
    )

    repo_root = File.expand_path("..", __dir__)
    workspace = Dir[File.join(repo_root, "ios", "*.xcworkspace")].first
    project = Dir[File.join(repo_root, "ios", "*.xcodeproj")].first
    UI.user_error!("ios/*.xcworkspace が無い。expo prebuild と pod install を先に流すこと") if workspace.nil?

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_adhoc_profile-name"]
    UI.user_error!("match が profile 名を返さんかった") if profile_name.to_s.empty?

    target = File.basename(workspace, ".xcworkspace")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      targets: [target],
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      team_id: TEAM_ID,
    )

    gym(
      workspace: workspace,
      scheme: target,
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: File.join(repo_root, "build", "ios"),
      output_name: "equus-anatomy.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
      },
    )
  end

  desc "App Store 署名で IPA をビルドする（provision:true で match を書き込みモードにする）"
  lane :appstore_ipa do |options|
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
    )

    provision = options[:provision] == true
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      git_url: MATCH_GIT_URL,
      git_branch: MATCH_GIT_BRANCH,
      team_id: TEAM_ID,
      readonly: !provision,
    )

    repo_root = File.expand_path("..", __dir__)
    workspace = Dir[File.join(repo_root, "ios", "*.xcworkspace")].first
    project = Dir[File.join(repo_root, "ios", "*.xcodeproj")].first
    UI.user_error!("ios/*.xcworkspace が無い。expo prebuild と pod install を先に流すこと") if workspace.nil?

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]
    UI.user_error!("match が profile 名を返さんかった") if profile_name.to_s.empty?

    target = File.basename(workspace, ".xcworkspace")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      targets: [target],
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      team_id: TEAM_ID,
    )

    gym(
      workspace: workspace,
      scheme: target,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(repo_root, "build", "ios"),
      output_name: "equus-anatomy-appstore.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
      },
    )
  end

  desc "TestFlight へアップロードする（submit_review:true で Beta App Review へ提出）"
  lane :beta do |options|
    appstore_ipa(provision: options[:provision])

    repo_root = File.expand_path("..", __dir__)
    ipa = File.join(repo_root, "build", "ios", "equus-anatomy-appstore.ipa")
    UI.user_error!("IPA が無い: #{ipa}") unless File.exist?(ipa)

    # Beta App Review の提出は外部テスト配布が前提。ASC 側で外部テスト
    # グループとレビュー情報（連絡先・デモアカウント等）が揃ってから
    # submit_review:true / external:true / groups:"..." を指定する。
    submit_review = options[:submit_review] == true
    external = options[:external] == true || submit_review
    UI.user_error!("external:true には groups が必要です") if external && options[:groups].to_s.empty?

    upload_to_testflight(
      ipa: ipa,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: options[:wait] != true,
      distribute_external: external,
      groups: options[:groups] ? options[:groups].split(",") : nil,
      changelog: options[:changelog] || ENV["RELEASE_NOTES"],
      notify_external_testers: external,
      submit_beta_review: submit_review,
    )
  end
end
