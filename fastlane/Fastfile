APP_IDENTIFIER = "jp.co.ritmo.equusanatomy"
TEAM_ID = "ZZ4FA7NLUY"
MATCH_GIT_URL = "git@github.com:ritmo-inc/horsemanager-certificates.git"
MATCH_GIT_BRANCH = "master"

default_platform(:ios)

platform :ios do
  desc "AdHoc 署名で IPA をビルドする（provision:true で match を書き込みモードにする）"
  lane :fad do |options|
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
    )

    provision = options[:provision] == true
    match(
      type: "adhoc",
      app_identifier: APP_IDENTIFIER,
      git_url: MATCH_GIT_URL,
      git_branch: MATCH_GIT_BRANCH,
      team_id: TEAM_ID,
      readonly: !provision,
      force_for_new_devices: provision,
    )

    workspace = Dir["ios/*.xcworkspace"].first
    project = Dir["ios/*.xcodeproj"].first
    UI.user_error!("ios/*.xcworkspace が無い。expo prebuild と pod install を先に流すこと") if workspace.nil?

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_adhoc_profile-name"]
    UI.user_error!("match が profile 名を返さんかった") if profile_name.to_s.empty?

    target = File.basename(workspace, ".xcworkspace")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      targets: [target],
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
    )

    gym(
      workspace: workspace,
      scheme: target,
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: "build/ios",
      output_name: "equus-anatomy.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
      },
    )
  end
end
