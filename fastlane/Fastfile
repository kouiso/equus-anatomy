APP_IDENTIFIER = "jp.co.ritmo.equusanatomy"
TEAM_ID = "ZZ4FA7NLUY"
MATCH_GIT_URL = "git@github.com:ritmo-inc/apple-certificate.git"
MATCH_GIT_BRANCH = "master"

default_platform(:ios)

platform :ios do
  desc "FAD テスターの UDID を取得して Apple Developer Portal に登録する"
  lane :register_devices_from_firebase do |options|
    app = options[:app] || ENV["FIREBASE_IOS_APP_ID"]
    devices_file = options[:output] || File.expand_path("../.device-sync/fad_devices.txt", __dir__)
    api_key_path = options[:api_key_path] || ENV["ASC_API_KEY_PATH"]

    UI.user_error!("app は必須です") if app.to_s.empty?
    UI.user_error!("api_key_path もしくは ASC_API_KEY_PATH が必要です") if api_key_path.to_s.empty?

    FileUtils.mkdir_p(File.dirname(devices_file))
    udid_options = {
      app: app,
      output_file: devices_file,
    }
    firebase_token = ENV["FIREBASE_AUTH_TOKEN"] || ENV["FIREBASE_TOKEN"]
    udid_options[:firebase_cli_token] = firebase_token unless firebase_token.to_s.empty?
    firebase_app_distribution_get_udids(**udid_options)

    device_count = File.exist?(devices_file) \
      ? File.readlines(devices_file).reject { |line| line.start_with?("Device ID") }.count { |line| !line.strip.empty? } \
      : 0
    UI.message("検出されたデバイス数: #{device_count}")
    next if device_count == 0

    register_devices(
      devices_file: devices_file,
      team_id: TEAM_ID,
      api_key_path: api_key_path,
    )
  end

  desc "AdHoc 署名で IPA をビルドする（provision:true で match を書き込みモードにする）"
  lane :fad do |options|
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
    )

    provision = options[:provision] == true
    match(
      type: "adhoc",
      app_identifier: APP_IDENTIFIER,
      git_url: MATCH_GIT_URL,
      git_branch: MATCH_GIT_BRANCH,
      team_id: TEAM_ID,
      readonly: !provision,
      force_for_new_devices: provision,
    )

    repo_root = File.expand_path("..", __dir__)
    workspace = Dir[File.join(repo_root, "ios", "*.xcworkspace")].first
    project = Dir[File.join(repo_root, "ios", "*.xcodeproj")].first
    UI.user_error!("ios/*.xcworkspace が無い。expo prebuild と pod install を先に流すこと") if workspace.nil?

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_adhoc_profile-name"]
    UI.user_error!("match が profile 名を返さんかった") if profile_name.to_s.empty?

    target = File.basename(workspace, ".xcworkspace")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project,
      targets: [target],
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      team_id: TEAM_ID,
    )

    gym(
      workspace: workspace,
      scheme: target,
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: File.join(repo_root, "build", "ios"),
      output_name: "equus-anatomy.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
      },
    )
  end
end
